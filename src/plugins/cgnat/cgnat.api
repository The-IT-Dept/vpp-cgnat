option version = "0.1.0";
import "vnet/ip/ip_types.api";
import "vnet/interface_types.api";

/** \brief Add or delete a deterministic map (inside prefix -> outside pool)
    @param is_add - add if true, delete if false
    @param in_vrf - inside table id
    @param in_addr / in_plen - inside prefix
    @param out_vrf - outside table id
    @param out_addr / out_plen - outside pool prefix
*/
autoreply define cgnat_map_add_del {
  u32 client_index;
  u32 context;
  bool is_add;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
  u8 in_plen;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u8 out_plen;
};

define cgnat_map_dump {
  u32 client_index;
  u32 context;
};

define cgnat_map_details {
  u32 context;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
  u8 in_plen;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u8 out_plen;
  u32 ratio;
  u16 ports_per_sub;
};

/** \brief Subscriber -> outside address and port block */
define cgnat_forward {
  u32 client_index;
  u32 context;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

define cgnat_forward_reply {
  u32 context;
  i32 retval;
  vl_api_ip4_address_t out_addr;
  u16 port_lo;
  u16 port_hi;
};

/** \brief Outside address:port -> subscriber */
define cgnat_reverse {
  u32 client_index;
  u32 context;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u16 out_port;
};

define cgnat_reverse_reply {
  u32 context;
  i32 retval;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

/** \brief Enable/disable translation on an interface
    @param is_add - enable if true
    @param is_inside - inside (subscriber side) if true, else outside
    @param sw_if_index - interface
*/
autoreply define cgnat_interface_add_del_feature {
  u32 client_index;
  u32 context;
  bool is_add;
  bool is_inside;
  vl_api_interface_index_t sw_if_index;
};

/** \brief Inbound filtering for live mappings
    @param endpoint_independent - any remote may reach a mapping if true;
           if false (default) only remote addresses the mapping has talked to
*/
autoreply define cgnat_set_filtering {
  u32 client_index;
  u32 context;
  bool endpoint_independent;
};

/** \brief Session limits per subscriber
    @param per_subscriber - sessions the subscriber opens (default 1000)
    @param inbound_per_subscriber - sessions opened towards the subscriber
           by inbound packets, a separate budget so outsiders can't use up
           the subscriber's own (default 250); 0 leaves it unchanged
*/
autoreply define cgnat_set_session_limit {
  u32 client_index;
  u32 context;
  u32 per_subscriber;
  u32 inbound_per_subscriber;
};

/** \brief Session idle timeouts, seconds
    (defaults: tcp_established 7440, tcp_transitory 240, udp 300, icmp 60)
*/
autoreply define cgnat_set_timeouts {
  u32 client_index;
  u32 context;
  u32 tcp_established;
  u32 tcp_transitory;
  u32 udp;
  u32 icmp;
};

/** \brief Dump sessions: all, or one subscriber's
    @param all - every session if true
    @param in_vrf / in_addr - the subscriber, if not all
*/
define cgnat_session_dump {
  u32 client_index;
  u32 context;
  bool all;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

/** \brief A session
    @param proto - IP protocol number (6, 17, 1)
    @param timeout_class - tcp-established, tcp-transitory, udp or icmp
    @param idle - seconds since the session last saw traffic
*/
define cgnat_session_details {
  u32 context;
  u32 thread_index;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
  u16 in_port;
  vl_api_ip4_address_t out_addr;
  u16 out_port;
  vl_api_ip4_address_t remote_addr;
  u16 remote_port;
  u8 proto;
  string timeout_class[16];
  f64 idle;
  bool warm;
};

define cgnat_get_status {
  u32 client_index;
  u32 context;
};

define cgnat_get_status_reply {
  u32 context;
  i32 retval;
  u32 maps;
  u64 sessions;
  u64 mappings;
  u64 subscribers;
  bool endpoint_independent_filtering;
  u32 sessions_per_subscriber;
  u32 inbound_sessions_per_subscriber;
  u32 max_sessions_per_thread;
  u32 tcp_established_timeout;
  u32 tcp_transitory_timeout;
  u32 udp_timeout;
  u32 icmp_timeout;
};

/** \brief Enable/disable the HA pair on this node
    @param node_id - this node's id (1..255, unique in the pair)
    @param local / peer - pair-link addresses
    @param table_id - table the pair link is in
    @param port - UDP port (0: 6200)
    @param hello_interval_ms / dead_interval_ms / refresh_interval_s - 0: defaults 100 / 500 / 10
*/
autoreply define cgnat_cluster_set {
  u32 client_index;
  u32 context;
  bool enable;
  u8 node_id;
  vl_api_ip4_address_t local;
  vl_api_ip4_address_t peer;
  u32 table_id;
  u16 port;
  u32 hello_interval_ms;
  u32 dead_interval_ms;
  u32 refresh_interval_s;
};

/** \brief Add/delete an extra liveness path (inside/outside networks) */
autoreply define cgnat_cluster_path_add_del {
  u32 client_index;
  u32 context;
  bool is_add;
  vl_api_ip4_address_t local;
  vl_api_ip4_address_t peer;
  u32 table_id;
};

/** \brief Which node owns a subscriber (0: none active) */
define cgnat_cluster_owner {
  u32 client_index;
  u32 context;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

define cgnat_cluster_owner_reply {
  u32 context;
  i32 retval;
  u8 node_id;
};

define cgnat_cluster_get_status {
  u32 client_index;
  u32 context;
};

define cgnat_cluster_get_status_reply {
  u32 context;
  i32 retval;
  bool enabled;
  u8 node_id;
  u8 peer_node_id;
  bool ready;
  bool fenced;
  string reason[32];
  bool peer_alive;
  bool pair_alive;
  bool peer_ready;
  u32 config_hash;
  u32 peer_config_hash;
  u32 epoch;
  u32 peer_epoch;
};
