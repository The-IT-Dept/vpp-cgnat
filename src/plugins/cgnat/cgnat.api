option version = "0.1.0";
import "vnet/ip/ip_types.api";
import "vnet/interface_types.api";

/** \brief Add or delete a deterministic map (inside prefix -> outside pool)
    @param is_add - add if true, delete if false
    @param in_vrf - inside table id
    @param in_addr / in_plen - inside prefix
    @param out_vrf - outside table id
    @param out_addr / out_plen - outside pool prefix
*/
autoreply define cgnat_map_add_del {
  u32 client_index;
  u32 context;
  bool is_add;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
  u8 in_plen;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u8 out_plen;
};

define cgnat_map_dump {
  u32 client_index;
  u32 context;
};

define cgnat_map_details {
  u32 context;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
  u8 in_plen;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u8 out_plen;
  u32 ratio;
  u16 ports_per_sub;
};

/** \brief Subscriber -> outside address and port block */
define cgnat_forward {
  u32 client_index;
  u32 context;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

define cgnat_forward_reply {
  u32 context;
  i32 retval;
  vl_api_ip4_address_t out_addr;
  u16 port_lo;
  u16 port_hi;
};

/** \brief Outside address:port -> subscriber */
define cgnat_reverse {
  u32 client_index;
  u32 context;
  u32 out_vrf;
  vl_api_ip4_address_t out_addr;
  u16 out_port;
};

define cgnat_reverse_reply {
  u32 context;
  i32 retval;
  u32 in_vrf;
  vl_api_ip4_address_t in_addr;
};

/** \brief Enable/disable translation on an interface
    @param is_add - enable if true
    @param is_inside - inside (subscriber side) if true, else outside
    @param sw_if_index - interface
*/
autoreply define cgnat_interface_add_del_feature {
  u32 client_index;
  u32 context;
  bool is_add;
  bool is_inside;
  vl_api_interface_index_t sw_if_index;
};

/** \brief Inbound filtering for live mappings
    @param endpoint_independent - any remote may reach a mapping if true;
           if false (default) only remote addresses the mapping has talked to
*/
autoreply define cgnat_set_filtering {
  u32 client_index;
  u32 context;
  bool endpoint_independent;
};

/** \brief Maximum sessions per subscriber (default 1000) */
autoreply define cgnat_set_session_limit {
  u32 client_index;
  u32 context;
  u32 per_subscriber;
};

/** \brief Session idle timeouts, seconds
    (defaults: tcp_established 7440, tcp_transitory 240, udp 300, icmp 60)
*/
autoreply define cgnat_set_timeouts {
  u32 client_index;
  u32 context;
  u32 tcp_established;
  u32 tcp_transitory;
  u32 udp;
  u32 icmp;
};
