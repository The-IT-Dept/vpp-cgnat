index c603a721e..c31dfd2a1 100644
--- a/src/vnet/bfd/bfd_main.h
+++ b/src/vnet/bfd/bfd_main.h
@@ -458,6 +458,25 @@ const char *bfd_hop_type_string (bfd_hop_type_e state);
 #define NSEC_PER_SEC (NSEC_PER_USEC * USEC_PER_SEC)
 #define SEC_PER_NSEC ((f64)1/NSEC_PER_SEC)
 
+/**
+ * BFD's clock in nsec, the same on every thread.
+ *
+ * Control frames are consumed on the thread that receives them, usually a
+ * worker, while the timers run on the main thread, so session timestamps are
+ * written by one thread and compared by another.  vlib time is per thread and
+ * the threads can disagree by seconds: a worker that runs ahead of main is not
+ * pulled back at a barrier.  Once a worker was further ahead than the peer's
+ * transmit interval, every frame received pushed the next transmit time out of
+ * main's reach and periodic transmission stopped for good.
+ */
+always_inline u64
+bfd_clock_now_nsec (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (u64) ts.tv_sec * NSEC_PER_SEC + ts.tv_nsec;
+}
+
 /** timing wheel tick-rate, 1ms should be good enough */
 #define BFD_TW_TPS (MSEC_PER_SEC)
 
