+@tag_run_solo
+class BFDWorkerClockTestCase(VppTestCase):
+    """BFD with a worker clock ahead of the main thread's"""
+
+    vpp_worker_count = 1
+    pg0 = None
+    vpp_clock_offset = None
+    vpp_session = None
+    test_session = None
+
+    @classmethod
+    def setUpClass(cls):
+        super(BFDWorkerClockTestCase, cls).setUpClass()
+        try:
+            cls.create_pg_interfaces([0])
+            cls.pg0.config_ip4()
+            cls.pg0.configure_ipv4_neighbors()
+            cls.pg0.admin_up()
+            cls.pg0.resolve_arp()
+        except Exception:
+            super(BFDWorkerClockTestCase, cls).tearDownClass()
+            raise
+
+    @classmethod
+    def tearDownClass(cls):
+        super(BFDWorkerClockTestCase, cls).tearDownClass()
+
+    def setUp(self):
+        super(BFDWorkerClockTestCase, self).setUp()
+        self.vapi.want_bfd_events()
+        self.pg0.enable_capture()
+        try:
+            self.vpp_session = VppBFDUDPSession(self, self.pg0, self.pg0.remote_ip4)
+            self.vpp_session.add_vpp_config()
+            self.vpp_session.admin_up()
+            self.test_session = BFDTestSession(self, self.pg0, AF_INET)
+        except BaseException:
+            self.vapi.want_bfd_events(enable_disable=0)
+            raise
+
+    def tearDown(self):
+        if not self.vpp_dead:
+            self.vapi.want_bfd_events(enable_disable=0)
+        self.vapi.collect_events()  # clear the event queue
+        super(BFDWorkerClockTestCase, self).tearDown()
+
+    def move_worker_clock_ahead(self, seconds):
+        """Put the worker's clock ahead of main's, as long-running VPP 26.06
+        did (vlib_worker_thread_barrier_check() never pulls it back)."""
+        # control frames are received on the worker, timers run on main
+        rx_on_worker = bfd_grab_stats_snapshot(self, thread_index=1).rx
+        self.assertGreater(rx_on_worker, 0, "control frames received on worker")
+        self.vapi.cli("test time worker-skew %s" % seconds)
+        clock = self.vapi.cli("show clock")
+        error = re.search(r"Thread 1 offset \S+ error (\S+)", clock)
+        self.assertIsNotNone(error, clock)
+        # error is main's minus the worker's time at the last barrier release
+        self.assertLess(float(error.group(1)), -(seconds - 1), clock)
+
+    def keep_peer_up(self, duration, interval):
+        """Send Up control frames from the peer for duration seconds"""
+        deadline = time.time() + duration
+        while time.time() < deadline:
+            self.test_session.send_packet()
+            self.sleep(interval, "peer transmit interval")
+
+    def test_periodic_tx_with_worker_clock_ahead(self):
+        """periodic control frames with a worker clock ahead of main's"""
+        bfd_session_up(self)
+        self.move_worker_clock_ahead(5)
+        before = bfd_grab_stats_snapshot(self)
+        # the peer transmits more often than the worker's lead
+        self.keep_peer_up(3, 0.1)
+        diff = bfd_stats_diff(before, bfd_grab_stats_snapshot(self))
+        # vpp's transmit interval is 225-300 ms, ~10-13 frames in 3 s
+        self.assertGreaterEqual(diff.tx, 5, "control frames sent by vpp in 3 s")
+        self.assert_equal(self.vpp_session.state, BFDState.up, BFDState)
+
+    def test_show_last_frame_age(self):
+        """show bfd sessions reports the age of the last control frames"""
+        bfd_session_up(self)
+        self.move_worker_clock_ahead(5)
+        self.keep_peer_up(1, 0.1)
+        out = self.vapi.cli("show bfd sessions")
+        ages = re.findall(r"Last control frame (tx|rx)\s+(\S+)s ago", out)
+        self.assert_equal(len(ages), 2, "last control frame tx/rx lines")
+        for direction, age in ages:
+            self.assert_in_range(
+                float(age), 0, 1, "last control frame %s age" % direction
+            )
