VPP 26.06 BFD fixes. Applies on v26.06 after vpp-26.06-time-monotonic.patch
(order in patches/series; apply with scripts/apply-patches.sh). Don't ship
it without that patch, or a base that has master 7d65ef4b8 (see 2).

1. Advertise the DesiredMinTx VPP transmits at (RFC 5880 6.8.3). VPP
   advertised the configured 100 ms while still transmitting at the slow
   rate. Junos trusts the advertised value, so it expired the session after
   every Poll, about 10 flaps a minute. Frames now advertise the effective
   value (>= 1 s in Down and AdminDown). While Up, a change is advertised
   from the first frame of its Poll (the Poll starts before that frame is
   built) and applied on the Final. A Final VPP sends while its own Poll is
   pending carries the change and applies it (RFC 5880 6.5); 26.06 cleared
   the Poll and never applied the change.

2. Use one clock for every BFD timestamp. Control frames are consumed on
   workers and timers run on main, and each stamped session times with its
   own thread's vlib time. In 26.06 the per-thread clocks drift apart as
   uptime grows (vppinfra 5c19169ae; vpp-26.06-time-monotonic.patch, the
   backport of master 7d65ef4b8, removes the drift). A barrier never pulls
   back a worker that is ahead of main. Once a worker led main by more than
   the peer's transmit interval, every frame it received pushed
   tx_timeout_nsec out of main's reach. VPP stopped transmitting and sat in
   Init until it was restarted (cgnat-1/2 on 2026-10-27/28, with workers
   66 s and 71 s ahead of main). BFD now reads CLOCK_MONOTONIC on every
   thread, for session times and for its timing wheel, so it no longer
   depends on the threads' vlib clocks agreeing. bfd-process still sleeps
   on the main thread's vlib clock (vlib_process_wait_for_event_or_clock),
   so a backward step in main's own vlib time would delay its wakeups by
   the size of the step; the time-monotonic patch rules those out.

3. "show bfd sessions" Last control frame ... ago subtracted nsec from CPU
   cycles (fixed upstream by 2d01d5822). It now uses BFD's clock.

4. Timer arithmetic. bfd_set_timer wrapped when the next event was already
   due (a transmit that found no buffer, an echo timeout passed while a
   worker consumed a frame) and put the session's timer ~48 days out; it
   now fires on the next tick. bfd_process multiplied seconds by
   SEC_PER_NSEC for its next wakeup; now NSEC_PER_SEC.

Tests, test_bfd.py BFD4TestCase (single and multihop):
test_des_min_tx_while_not_up fails on 26.06 (Down advertises 300000, not
1000000); test_modify_des_min_tx_poll fails if the Poll's first frame
advertises the old value; test_peer_poll_during_own_poll fails if a Final
sent during VPP's own Poll leaves the change unapplied.
BFDWorkerClockTestCase uses "test time worker-skew" in the unittest plugin
to put the worker 5 s ahead of main. Both its tests fail without 2 and 3
and pass with them, also on top of time-monotonic. "test time worker-skew
<sec> hold" keeps the workers <sec> from main (<0: behind) across
barriers, which pull a worker that is behind up to main; vpp-cgnat's
test_cgnat.py and test_cgnat_cluster.py use both forms. On v26.06 +
patches/series, make test-debug and make test (release) TEST=bfd:
143 pass, 14 skip; TEST=test_time: 7 pass.

diff --git a/src/plugins/unittest/time_test.c b/src/plugins/unittest/time_test.c
index 0653391d2..e4aeb61dc 100644
--- a/src/plugins/unittest/time_test.c
+++ b/src/plugins/unittest/time_test.c
@@ -370,6 +370,149 @@ test_barrier_time_monotonicity (vlib_main_t *vm)
   return error;
 }
 
+/*
+ * Move every worker's clock away from the main thread's, from the worker
+ * itself, as per-thread clock drift does.  Used by test_bfd.py and by
+ * vpp-cgnat's tests.
+ *
+ * "worker-skew <sec>" adds <sec> to each worker's clock once.  The barrier
+ * keeps a worker that is ahead of main where it is (see
+ * vlib_worker_thread_barrier_check()), so a lead persists.
+ *
+ * "worker-skew <sec> hold" keeps each worker <sec> from main (negative:
+ * behind) until the next worker-skew command.  A barrier pulls a worker that
+ * is behind main up to main's clock, so the worker sets its clock again after
+ * every barrier, before its other nodes stamp anything: input nodes that
+ * poll come before interrupts and pending frames.  "worker-skew 0 hold" then
+ * "worker-skew 0" puts the workers back on main's clock.
+ */
+
+static f64 time_test_worker_skew;
+static u8 time_test_skew_hold;
+static u32 time_test_workers_skewed;
+/* per thread, held: the barrier release the skew was last set after, and the
+ * worker's vlib time and CLOCK_MONOTONIC just after it set it */
+static f64 *time_test_skew_release;
+static f64 *time_test_skew_vlib;
+static f64 *time_test_skew_mono;
+
+static f64
+time_test_monotonic_now (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+
+static uword
+time_test_skew_input_fn (vlib_main_t *vm, vlib_node_runtime_t *node, vlib_frame_t *frame)
+{
+  u32 ti = vm->thread_index;
+  f64 lead;
+
+  if (ti == 0)
+    return 0;
+
+  if (!time_test_skew_hold)
+    {
+      vlib_time_adjust (vm, time_test_worker_skew);
+      vlib_node_set_state (vm, node->node_index, VLIB_NODE_STATE_DISABLED);
+      clib_atomic_fetch_add (&time_test_workers_skewed, 1);
+      return 0;
+    }
+
+  /* held: once after each barrier.  The worker left it on main's clock, or
+   * where it was if it was ahead of main. */
+  if (vm->time_last_barrier_release == time_test_skew_release[ti])
+    return 0;
+  time_test_skew_release[ti] = vm->time_last_barrier_release;
+  lead = vm->time_last_barrier_release - vlib_get_first_main ()->time_last_barrier_release;
+  vlib_time_adjust (vm, time_test_worker_skew - lead);
+  time_test_skew_vlib[ti] = vlib_time_now (vm);
+  time_test_skew_mono[ti] = time_test_monotonic_now ();
+  clib_atomic_fetch_add (&time_test_workers_skewed, 1);
+  return 0;
+}
+
+VLIB_REGISTER_NODE (time_test_skew_input_node) = {
+  .function = time_test_skew_input_fn,
+  .type = VLIB_NODE_TYPE_INPUT,
+  .name = "time-test-skew-input",
+  .state = VLIB_NODE_STATE_DISABLED,
+};
+
+static clib_error_t *
+time_test_wait_skewed (vlib_main_t *vm, u32 n_workers)
+{
+  f64 deadline = vlib_time_now (vm) + 5.0;
+
+  while (clib_atomic_load_acq_n (&time_test_workers_skewed) < n_workers)
+    {
+      if (vlib_time_now (vm) > deadline)
+	return clib_error_return (0, "workers did not apply the skew");
+      vlib_process_suspend (vm, 1e-4);
+    }
+  return 0;
+}
+
+static clib_error_t *
+test_time_worker_skew (vlib_main_t *vm, f64 skew, int hold)
+{
+  u32 n_workers = vlib_get_n_threads () - 1;
+  clib_error_t *error;
+
+  if (!n_workers)
+    return clib_error_return (0, "worker-skew requires workers");
+  if (skew < 0 && !hold)
+    return clib_error_return (0, "a worker behind main catches up at the next "
+				 "barrier: use worker-skew <sec> hold");
+
+  vlib_worker_thread_barrier_sync (vm);
+  time_test_worker_skew = skew;
+  time_test_skew_hold = hold;
+  clib_atomic_store_rel_n (&time_test_workers_skewed, 0);
+  vec_validate (time_test_skew_release, n_workers);
+  vec_validate (time_test_skew_vlib, n_workers);
+  vec_validate (time_test_skew_mono, n_workers);
+  for (u32 i = 0; i <= n_workers; i++)
+    time_test_skew_release[i] = -1;
+  foreach_vlib_main ()
+    {
+      if (this_vlib_main->thread_index != 0)
+	vlib_node_set_state (this_vlib_main, time_test_skew_input_node.index,
+			     VLIB_NODE_STATE_POLLING);
+    }
+  vlib_worker_thread_barrier_release (vm);
+
+  if ((error = time_test_wait_skewed (vm, n_workers)))
+    return error;
+
+  /* a lead persists across a barrier; a held skew is set again after it */
+  clib_atomic_store_rel_n (&time_test_workers_skewed, 0);
+  vlib_worker_thread_barrier_sync (vm);
+  vlib_worker_thread_barrier_release (vm);
+  if (hold && (error = time_test_wait_skewed (vm, n_workers)))
+    return error;
+
+  /* The release returns once every worker has left the barrier and set its
+   * time_last_barrier_release.  Not foreach_vlib_main (): the barrier is
+   * released, and debug images assert that workers are parked in it. */
+  for (u32 i = 1; i <= n_workers; i++)
+    {
+      f64 lead;
+
+      if (hold)
+	/* the worker's clock now: its reading plus the time since */
+	lead = time_test_skew_vlib[i] + (time_test_monotonic_now () - time_test_skew_mono[i]) -
+	       vlib_time_now (vm);
+      else
+	lead =
+	  vlib_get_main_by_index (i)->time_last_barrier_release - vm->time_last_barrier_release;
+      vlib_cli_output (vm, "worker %u: %.3fs ahead of main%s", i, lead, hold ? " (held)" : "");
+    }
+  return 0;
+}
+
 static clib_error_t *
 test_time_command_fn (vlib_main_t *vm, unformat_input_t *input, vlib_cli_command_t *cmd)
 {
@@ -382,10 +525,15 @@ test_time_command_fn (vlib_main_t *vm, unformat_input_t *input, vlib_cli_command
   int test_virtual_offset = 0;
   int test_barrier = 0;
   int test_all = 0;
+  f64 skew;
 
   while (unformat_check_input (input) != UNFORMAT_END_OF_INPUT)
     {
-      if (unformat (input, "monotonicity"))
+      if (unformat (input, "worker-skew %f hold", &skew))
+	return test_time_worker_skew (vm, skew, 1 /* hold */);
+      else if (unformat (input, "worker-skew %f", &skew))
+	return test_time_worker_skew (vm, skew, 0);
+      else if (unformat (input, "monotonicity"))
 	test_monotonicity = 1;
       else if (unformat (input, "discontinuity"))
 	test_discontinuity = 1;
@@ -471,7 +619,7 @@ test_time_command_fn (vlib_main_t *vm, unformat_input_t *input, vlib_cli_command
 VLIB_CLI_COMMAND (test_time_command, static) = {
   .path = "test time",
   .short_help = "test time [monotonicity | discontinuity | small-discontinuity | accumulated-error "
-		"| wall-step | virtual-offset | barrier | all]",
+		"| wall-step | virtual-offset | barrier | all | worker-skew <sec> [hold]]",
   .function = test_time_command_fn,
   .is_mp_safe = 1,
 };
